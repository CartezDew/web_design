DJANGO_ENV=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=postgresql://app_user:password@localhost:5432/marcd_portal
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_COOKIE_DOMAIN=
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=Cartez Dewberry <letsbuild@marcdbycartez.com>
ADMIN_NOTIFICATION_EMAIL=letsbuild@marcdbycartez.com
RESEND_API_KEY=
# Production uses Microsoft 365 after the owner authorizes Mail.Send.
# Leave EMAIL_PROVIDER=console for local development.
EMAIL_PROVIDER=console
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_MAILBOX=letsbuild@marcdbycartez.com
MICROSOFT_TOKEN_ENCRYPTION_KEY=
UPLOAD_STORAGE_BACKEND=s3
UPLOAD_BACKUP_REQUIRED=false
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ADDRESSING_STYLE=virtual
S3_BACKUP_ENDPOINT_URL=
S3_BACKUP_BUCKET_NAME=
S3_BACKUP_REGION=auto
S3_BACKUP_ACCESS_KEY_ID=
S3_BACKUP_SECRET_ACCESS_KEY=
# Optional legacy GCS configuration
GOOGLE_CLOUD_PROJECT=
GS_BUCKET_NAME=
GS_CREDENTIALS_JSON=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false
NATIVE_FORM_PROTECTION=true
SECURE_SSL_REDIRECT=false
LOG_LEVEL=INFO
TRUST_RAILWAY_PROXY=false
